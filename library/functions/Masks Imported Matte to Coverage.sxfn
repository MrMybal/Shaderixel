{
 "format": "shaderixel-function",
 "name": "Masks Imported Matte to Coverage",
 "kind": "subgraph",
 "applyMode": false,
 "description": "Convert a numeric grayscale or channel PNG imported through Shaderixel color-image import into linear mask coverage. This compensates sRGB decoding so a PNG byte value 128 becomes about 0.5 coverage. Alpha is always read directly. Do not enable PNG decoding for an existing linear coverage mask.",
 "graph": {
  "output": 8,
  "variables": [
   {
    "name": "Decode PNG Numeric Values",
    "value": {
     "type": "Bool",
     "f": 1
    },
    "exposed": true,
    "desc": "Enable for normally imported grayscale PNG data; disable for existing linear masks."
   },
   {
    "name": "Invert Mask",
    "value": {
     "type": "Bool",
     "f": 0
    },
    "exposed": true,
    "desc": "Invert after channel extraction."
   },
   {
    "name": "Coverage Curve",
    "value": {
     "type": "Float",
     "f": 1
    },
    "exposed": true,
    "desc": "Coverage power (0.1 to 4)."
   }
  ],
