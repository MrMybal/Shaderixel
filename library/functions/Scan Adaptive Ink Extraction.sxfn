{
 "format": "shaderixel-function",
 "name": "Scan Adaptive Ink Extraction",
 "kind": "subgraph",
 "applyMode": false,
 "description": "Local paper threshold for uneven lighting. Adaptive radius and bias control stroke extraction; use a radius larger than stroke width. Preserves source coverage once.",
