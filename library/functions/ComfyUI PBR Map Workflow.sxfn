{
 "format": "shaderixel-function",
 "name": "ComfyUI PBR Map Workflow",
 "kind": "tool",
 "applyMode": false,
 "description": "Run a supplied API workflow for one PBR map: normal, roughness, albedo, etc. Requires LoadImage and a single SaveImage for the required map. Shaderixel retrieves only the first output image; use one instance per map. Empty path: show a message without running image-to-image. Output previews the photo before execution.",
 "graph": {
  "output": 10,
  "variables": [
   {
    "name": "Prompt",
    "value": {
     "type": "Text",
     "s": ""
    },
    "exposed": true,
    "desc": "Prompt substituted in workflow text encoders when present."
   }
  ],
  "nodes": [
   {
    "id": 1,
    "kind": "subinput",
    "pos": [
     0,
     0
    ],
    "inputs": [],
    "name": "Photo",
    "port": 0
   },
   {
    "id": 2,
    "kind": "subinput",
    "pos": [
     0,
     180
    ],
    "inputs": [],
