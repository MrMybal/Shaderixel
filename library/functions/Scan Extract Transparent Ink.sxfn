{
 "format": "shaderixel-function",
 "name": "Scan Extract Transparent Ink",
 "kind": "subgraph",
 "applyMode": false,
 "description": "Clean a paper scan, threshold dark strokes, refine coverage and colorize them on transparency. Additional outputs expose linear coverage and a paper preview. This is tonal extraction, not OCR or vector tracing.",
