{
  "format": "shaderixel-function",
  "name": "UI Toolkit Layout Pixel Art Sampling",
  "kind": "subgraph",
  "applyMode": false,
  "description": "Quantize source UVs to texel centers or a fractional grid, then sample with nearest filtering. Coverage stays attached to the original field.",
