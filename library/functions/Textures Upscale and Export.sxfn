    "port": 1,
    "value": {
     "type": "Int",
     "f": 2
    }
   },
   {
    "id": 3,
    "kind": "subinput",
    "pos": [
     0,
     360
    ],
    "inputs": [],
    "name": "PNG File",
    "port": 2,
    "value": {
     "type": "Text",
     "s": "texture_upscaled.png"
    }
   },
   {
    "id": 4,
    "kind": "varget",
    "pos": [
     320,
     0
    ],
    "inputs": [],
    "op": "Use ComfyUI",
    "value": {
     "type": "Bool"
    }
   },
   {
    "id": 5,
    "kind": "varget",
    "pos": [
     320,
     160
    ],
    "inputs": [],
