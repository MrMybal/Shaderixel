{
 "format": "shaderixel-function",
 "name": "Textures Upscale and Export",
 "kind": "tool",
 "applyMode": false,
 "description": "Upscale and Export uses local bicubic or a ComfyUI AI model, then exports PNG at full enlarged resolution. Graph output is fitted to document size. Scale factor 1 to 8; install the selected model in ComfyUI when AI is enabled.",
 "graph": {
  "output": 9,
  "variables": [
   {
    "name": "Use ComfyUI",
    "value": {
     "type": "Bool",
     "f": 0
    },
    "exposed": true,
    "desc": "Off: local bicubic; on: AI model on the configured server."
   },
   {
    "name": "Upscale Model",
    "value": {
     "type": "Name",
     "s": "4x-UltraSharp.pth"
    },
    "exposed": true,
    "desc": "Exact name of a model installed in ComfyUI models/upscale_models."
   }
  ],
  "nodes": [
   {
    "id": 1,
    "kind": "subinput",
    "pos": [
     0,
     0
    ],
    "inputs": [],
    "name": "Texture",
    "port": 0
   },
   {
    "id": 2,
    "kind": "subinput",
    "pos": [
     0,
     180
    ],
    "inputs": [],
