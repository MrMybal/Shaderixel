{
 "format": "shaderixel-function",
 "name": "PBR Photo to Maps and PNG Export",
 "kind": "tool",
 "applyMode": false,
 "description": "Extract and Export estimates, bakes and exports albedo, height, normals, occlusion, roughness, manual metalness and ORM. File prefix without extension. PNG is 8-bit; disable sRGB for data maps in the 3D engine. For precise height, use a 16-bit document export that keeps sRGB encoding.",
 "graph": {
  "output": 31,
  "variables": [
   {
    "name": "Denoise",
    "value": {
     "type": "Float",
     "f": 0.65
    },
    "exposed": true,
    "desc": "Cleanup strength before extraction (0 to 1)."
   },
   {
    "name": "Lighting Radius",
    "value": {
     "type": "Float",
     "f": 48
    },
    "exposed": true,
    "desc": "Blur radius in pixels (0 to 250): separates shading from detail."
   },
   {
    "name": "Lighting Correction",
    "value": {
     "type": "Float",
     "f": 0.8
    },
    "exposed": true,
    "desc": "Approximate removal of photo lighting (0 to 1)."
   },
   {
    "name": "Large-Scale Shapes",
    "value": {
     "type": "Float",
     "f": 0.2
    },
    "exposed": true,
    "desc": "Weight of large-scale luminance changes in the height map (0 to 2)."
   },
   {
    "name": "Invert Height",
    "value": {
     "type": "Bool",
     "f": 0
    },
    "exposed": true,
    "desc": "White means high by default; invert to suit the material."
   },
   {
    "name": "Roughness Detail",
    "value": {
     "type": "Float",
     "f": 1.5
    },
    "exposed": true,
    "desc": "Weight of local contrast in roughness (0 to 8)."
   },
   {
    "name": "Uniform Metalness",
    "value": {
     "type": "Float",
     "f": 0
    },
    "exposed": true,
    "desc": "Manual choice (0: dielectric, 1: metal); a photo alone cannot determine metalness."
   },
   {
    "name": "DirectX Normals",
    "value": {
     "type": "Bool",
     "f": 0
    },
    "exposed": true,
    "desc": "Off: OpenGL; on: flip green for DirectX."
   },
   {
