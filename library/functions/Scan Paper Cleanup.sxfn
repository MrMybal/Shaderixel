{
 "format": "shaderixel-function",
 "name": "Scan Paper Cleanup",
 "kind": "subgraph",
 "applyMode": false,
 "description": "Denoise and normalize uneven paper brightness, then remap black and white points. Use a paper radius larger than the strokes; dense dark regions may need lower correction.",
 "graph": {
