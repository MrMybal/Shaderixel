{
 "format": "shaderixel-function",
 "name": "Game Art Pixel Sprite Pipeline",
 "kind": "subgraph",
 "applyMode": false,
 "description": "Sample an integer pixel grid, apply a four-color palette with ordered dither, then add an outline. Outputs pixel sprite, outlined sprite and checker preview. This changes appearance without resizing the document; leave transparent padding around the sprite.",
