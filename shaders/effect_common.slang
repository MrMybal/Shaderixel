// Prelude for every effect program. The engine generates:
//   #define EFFECT_PREMULTIPLIED 0|1
//   cbuffer Params : register(b1) { ...one float4 slot per @param... };
// then appends the effect body, which must define:
//   float4 Effect(EffectContext ctx)
// and finally the generated kernel entry point.
//
// Coordinates are always ABSOLUTE document pixels: the engine may run an
// effect on a sub-rectangle (tiled rendering of very large images). Inputs
// can be stored in textures covering only part of the document; their origin
// is given per input. Effect code never needs to care.
#include "common.slang"

cbuffer EffectRoot : register(b0)
{
    uint2 gSize;        // dispatch size (pixels computed by this call)
    int2 gOrigin;       // document pixel of thread (0,0)
    uint2 gDocSize;     // full document size
    uint gPass;
    uint gInputMask;    // bit i set when input i is connected
    int4 gInOrigin01;   // input 0 origin (xy), input 1 origin (zw)
    int4 gInOrigin23;   // input 2 origin (xy), input 3 origin (zw)
};

Texture2D<float4> gIn0 : register(t0);
Texture2D<float4> gIn1 : register(t1);
Texture2D<float4> gIn2 : register(t2);
Texture2D<float4> gIn3 : register(t3);
Texture2D<float4> gPrevPass : register(t4);
RWTexture2D<float4> gOut : register(u0);

struct EffectContext
{
    int2 px;        // document pixel coordinate
    float2 uv;      // normalized coordinate over the whole document (pixel centers)
    float2 size;    // document size in pixels
    float2 texel;   // 1 / size
    uint pass;      // current pass index (multi-pass effects)
};

float4 FromStorage(float4 c)
{
#if EFFECT_PREMULTIPLIED
    return c;
#else
    return Unpremultiply(c);
#endif
}

float4 ToStorage(float4 c)
{
#if EFFECT_PREMULTIPLIED
    return c;
#else
    return Premultiply(float4(c.rgb, saturate(c.a)));
#endif
}

bool HasInput(uint i) { return (gInputMask & (1u << i)) != 0; }

int2 ClampPx(int2 p) { return clamp(p, int2(0, 0), int2(gDocSize) - 1); }

int2 InOrigin(uint i)
{
    switch (i)
    {
    case 0: return gInOrigin01.xy;
    case 1: return gInOrigin01.zw;
    case 2: return gInOrigin23.xy;
    default: return gInOrigin23.zw;
    }
}

float4 LoadTex(Texture2D<float4> t, int2 docPx, int2 origin)
{
    uint w, h;
    t.GetDimensions(w, h);
    int2 q = clamp(ClampPx(docPx) - origin, int2(0, 0), int2(w, h) - 1);
    return t.Load(int3(q, 0));
}

float4 SampleTex(Texture2D<float4> t, float2 docUv, int2 origin)
{
    uint w, h;
    t.GetDimensions(w, h);
    float2 local = (saturate(docUv) * float2(gDocSize) - float2(origin)) / float2(w, h);
    return t.SampleLevel(sLinearClamp, local, 0);
}

float4 LoadRaw(uint i, int2 p)
{
    switch (i)
    {
    case 0: return LoadTex(gIn0, p, gInOrigin01.xy);
    case 1: return LoadTex(gIn1, p, gInOrigin01.zw);
    case 2: return LoadTex(gIn2, p, gInOrigin23.xy);
    default: return LoadTex(gIn3, p, gInOrigin23.zw);
    }
}

float4 SampleRaw(uint i, float2 uv)
{
    switch (i)
    {
    case 0: return SampleTex(gIn0, uv, gInOrigin01.xy);
    case 1: return SampleTex(gIn1, uv, gInOrigin01.zw);
    case 2: return SampleTex(gIn2, uv, gInOrigin23.xy);
    default: return SampleTex(gIn3, uv, gInOrigin23.zw);
    }
}

// Read input i at a pixel / normalized coordinate (in the effect's color space).
float4 Input(uint i, int2 p) { return FromStorage(LoadRaw(i, p)); }
float4 InputUV(uint i, float2 uv) { return FromStorage(SampleRaw(i, uv)); }

// Output of the previous pass (pass 0: same as input 0). Passes share the dispatch rectangle.
float4 Prev(int2 p) { return FromStorage(gPass == 0 ? LoadRaw(0, p) : LoadTex(gPrevPass, p, gOrigin)); }
float4 PrevUV(float2 uv) { return FromStorage(gPass == 0 ? SampleRaw(0, uv) : SampleTex(gPrevPass, uv, gOrigin)); }

// The kernel entry point `main` is generated by the engine after the effect body.
