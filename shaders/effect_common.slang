// Prelude for every effect program. The engine generates:
//   #define EFFECT_PREMULTIPLIED 0|1
//   cbuffer Params : register(b1) { ...one float4 slot per @param... };
// then appends the effect body, which must define:
//   float4 Effect(EffectContext ctx)
// and finally the generated kernel entry point.
#include "common.slang"

cbuffer EffectRoot : register(b0)
{
    uint2 gSize;
    uint gPass;
    uint gInputMask;    // bit i set when input i is connected
    uint gSeed;
    float gTime;
};

Texture2D<float4> gIn0 : register(t0);
Texture2D<float4> gIn1 : register(t1);
Texture2D<float4> gIn2 : register(t2);
Texture2D<float4> gIn3 : register(t3);
Texture2D<float4> gPrevPass : register(t4);
RWTexture2D<float4> gOut : register(u0);

struct EffectContext
{
    int2 px;        // pixel coordinate
    float2 uv;      // normalized coordinate (pixel centers)
    float2 size;    // image size in pixels
    float2 texel;   // 1 / size
    uint pass;      // current pass index (multi-pass effects)
};

float4 FromStorage(float4 c)
{
#if EFFECT_PREMULTIPLIED
    return c;
#else
    return Unpremultiply(c);
#endif
}

float4 ToStorage(float4 c)
{
#if EFFECT_PREMULTIPLIED
    return c;
#else
    return Premultiply(float4(c.rgb, saturate(c.a)));
#endif
}

bool HasInput(uint i) { return (gInputMask & (1u << i)) != 0; }

int2 ClampPx(int2 p) { return clamp(p, int2(0, 0), int2(gSize) - 1); }

float4 LoadRaw(uint i, int2 p)
{
    int3 q = int3(ClampPx(p), 0);
    switch (i)
    {
    case 0: return gIn0.Load(q);
    case 1: return gIn1.Load(q);
    case 2: return gIn2.Load(q);
    default: return gIn3.Load(q);
    }
}

float4 SampleRaw(uint i, float2 uv)
{
    switch (i)
    {
    case 0: return gIn0.SampleLevel(sLinearClamp, uv, 0);
    case 1: return gIn1.SampleLevel(sLinearClamp, uv, 0);
    case 2: return gIn2.SampleLevel(sLinearClamp, uv, 0);
    default: return gIn3.SampleLevel(sLinearClamp, uv, 0);
    }
}

// Read input i at a pixel / normalized coordinate (in the effect's color space).
float4 Input(uint i, int2 p) { return FromStorage(LoadRaw(i, p)); }
float4 InputUV(uint i, float2 uv) { return FromStorage(SampleRaw(i, uv)); }

// Output of the previous pass (pass 0: same as input 0).
float4 Prev(int2 p) { return FromStorage(gPass == 0 ? LoadRaw(0, p) : gPrevPass.Load(int3(ClampPx(p), 0))); }
float4 PrevUV(float2 uv) { return FromStorage(gPass == 0 ? SampleRaw(0, uv) : gPrevPass.SampleLevel(sLinearClamp, uv, 0)); }

// The kernel entry point `main` is generated by the engine after the effect body.
