 // - BulletTextV()
 //-------------------------------------------------------------------------
 
+// Shaderixel: per-window text filter (Unreal-like details filter), decided by the application.
+// GSXFilterFn(window, kind, label, label_end) returns true to hide / flatten:
+//   kind 0: labeled item (button, checkbox, slider, input, combo, color, selectable, menu item): hide it;
+//   kind 1: section (tree node, collapsing header, separator text, sub-menu): open it without drawing it;
+//   kind 2: plain text (label = the text, a matching text shows its line) / separator (no label): hide it;
+//   kind 3: end of a section (tree pop, end of an inline sub-menu).
+bool (*GSXFilterFn)(ImGuiWindow* window, int kind, const char* label, const char* label_end) = NULL;
+static ImVector<ImGuiWindow*> GSXInlineMenus;  // sub-menus drawn inline while filtering (EndMenu skips them)
+static inline bool SXFiltered(int kind, const char* label, const char* label_end = NULL)
+{
+    ImGuiContext& g = *GImGui;
+    return GSXFilterFn != NULL && GSXFilterFn(g.CurrentWindow, kind, label, label_end);
+}
