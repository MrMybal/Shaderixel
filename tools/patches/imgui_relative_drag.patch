 // This is called by DragBehavior() when the widget is active (held by mouse or being manipulated with Nav controls)
+// Shaderixel: relative mouse drags for sliders and drags. Sliders no longer jump
+// to the click: the value follows the mouse motion at a reduced base speed,
+// Shift = faster, Ctrl (while dragging) = slower. The application hides the
+// cursor and keeps it in place while GSXRelativeDragFrame == current frame,
+// supplies the true cursor motion in GSXMouseDelta (GSXUseMouseDelta) since the
+// cursor is warped back while dragging.
+ImVec2 GSXMouseDelta = ImVec2(0.0f, 0.0f);
+bool GSXUseMouseDelta = false;
+int GSXRelativeDragFrame = -1;
+float GSXDragSpeed = 0.6f, GSXDragFast = 4.0f, GSXDragSlow = 0.1f;
+static float SXDragDelta(ImGuiAxis axis, ImGuiSliderFlags flags)
+{
+    ImGuiContext& g = *GImGui;
+    GSXRelativeDragFrame = g.FrameCount;
+    ImGui::SetMouseCursor(ImGuiMouseCursor_None);
+    float d = GSXUseMouseDelta ? GSXMouseDelta[axis] : g.IO.MouseDelta[axis];
+    if (flags & ImGuiSliderFlags_NoSpeedTweaks)
+        return d * GSXDragSpeed;
+    return d * GSXDragSpeed * (g.IO.KeyShift ? GSXDragFast : 1.0f) * (g.IO.KeyCtrl ? GSXDragSlow : 1.0f);
+}
