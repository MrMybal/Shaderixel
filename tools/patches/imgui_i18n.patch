 // Internal ImGui functions to render text
 // RenderText***() functions calls ImDrawList::AddText() calls ImBitmapFont::RenderText()
+// Shaderixel: interface translation, decided by the application. Called with the visible text (after "##" removed);
+// may point *text / *text_end to the translated text (owned by the application, valid for the frame).
+bool (*GSXTranslateFn)(const char** text, const char** text_end) = NULL;
+static inline void SXTranslate(const char** text, const char** text_end)
+{
+    if (GSXTranslateFn && *text)
+    {
+        if (!*text_end)
+            *text_end = *text + ImStrlen(*text);
+        GSXTranslateFn(text, text_end);
+    }
+}
